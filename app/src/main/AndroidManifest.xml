<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
        </intent>
    </queries>

    <application
        android:name=".GeminiTranslateApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeminiLiveTranslate"
        android:usesCleartextTraffic="false">

        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.SubtitlePlaybackActivity" android:exported="false" />
        <activity android:name=".ui.LogViewerActivity" android:exported="false" />
        <activity android:name=".ui.TtsSettingsActivity" android:exported="false" />
        <activity android:name=".ui.ApiSettingsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.MiniBrowserActivity" android:exported="false" android:configChanges="orientation|screenSize" />

        <activity
            android:name=".ui.AiStudioWebSessionLogShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Nhật ký AI Studio" />

        <!-- R13.2: deep AI Studio Live WebChannel/audio probe. Account chooser experiment removed. -->
        <activity
            android:name=".ui.AiStudioWebSessionR13Activity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R13.2 - Deep Live Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proven R11.2 shell + R12 Direct Engine remains internal for closed-request regression tests. -->
        <activity
            android:name=".ui.AiStudioWebSessionR11R2Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R12 - Direct Engine" />

        <!-- Historical experiments remain registered only for internal/reference use, not launcher UI. -->
        <activity
            android:name=".ui.AiStudioWebSessionR11UnifiedActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R11.1 internal" />
        <activity
            android:name=".ui.AiStudioWebSessionR11Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R11 legacy" />
        <activity
            android:name=".ui.AiStudioWebSessionR10Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R10 - Executor" />
        <activity
            android:name=".ui.AiStudioWebSessionR7Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R7 - Không ghi textarea" />
        <activity
            android:name=".ui.AiStudioWebSessionR6Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R6 - Prompt state trực tiếp" />
        <activity
            android:name=".ui.AiStudioWebSessionR5Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R5 - Trực tiếp handler" />
        <activity
            android:name=".ui.AiStudioWebSessionR4Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session R4.1 - Không chạm" />
        <activity
            android:name=".ui.AiStudioWebSessionLabActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="AI Studio Web Session Lab" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TranslationService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>