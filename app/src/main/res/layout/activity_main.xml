<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Gemini Live Translate v1.0.0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/apiKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Key" />

        <Button
            android:id="@+id/testConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Kiểm tra API Key, model và kết nối Gemini"
            android:text="Kiểm tra API và kết nối" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguồn âm thanh:"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/audioSourceSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/micLanguageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngôn ngữ dịch Microphone:"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/micLanguageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/manageLanguagesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thêm hoặc xóa ngôn ngữ" />

            <Button
                android:id="@+id/nextLanguageButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chuyển ngôn ngữ"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/selectFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn tệp trong bộ nhớ" />

        <Button
            android:id="@+id/miniBrowserButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trình duyệt mini" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bắt đầu" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="4dp"
            android:text="Trạng thái: Sẵn sàng" />

        <LinearLayout
            android:id="@+id/fileControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rewindButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tua lùi 10 giây" />

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phát" />

            <Button
                android:id="@+id/forwardButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tua tiến 10 giây" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/progressSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Tiến trình phát: 0%"
            android:max="100" />

        <SeekBar
            android:id="@+id/originalVolumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Âm lượng gốc: 50%"
            android:max="100"
            android:progress="50" />

        <SeekBar
            android:id="@+id/translatedVolumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="Âm lượng dịch: 100%"
            android:max="100"
            android:progress="100" />

        <Switch
            android:id="@+id/aiVoiceSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Giọng AI" />

        <LinearLayout
            android:id="@+id/aiAudioStreamLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Luồng phát giọng AI (aiAudioStreamType):"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/aiAudioStreamSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Switch
            android:id="@+id/autoDuckingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự động giảm âm nền" />

        <ScrollView
            android:id="@+id/subtitleScroll"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="Phụ đề"
            android:focusable="true">

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có nội dung dịch"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </ScrollView>

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xuất phụ đề (.srt)" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cài đặt nâng cao" />

        <Button
            android:id="@+id/logButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem nhật ký lỗi" />
    </LinearLayout>
</ScrollView>
